# Copy to .env and fill in what you need. run_app reads this file at start-up.
# Both keys are optional: the app and the "Desktop bridge" agent profile work without them.

# Claude profile in the Scenario agents chat
ANTHROPIC_API_KEY=

# NVIDIA profile in the Scenario agents chat
NVIDIA_API_KEY=

# Port the front end listens on
SUPPLY_BRAIN_PORT=8501

# Set to 1 to let other computers on your network open the app (Windows Firewall will ask once)
SUPPLY_BRAIN_SHARE=0
